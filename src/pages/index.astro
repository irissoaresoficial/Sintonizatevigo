---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { evento, ponentes, SHEETS_ENDPOINT } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// [r]…[/r] marca las palabras de acento (rojo; negro sobre fondo rojo).
const hl = (s: string) => s.replace(/\[r\]/g, '<span class="hl">').replace(/\[\/r\]/g, '</span>');

const ticker = [
  '¿Tu rueda gira o se atasca?', 'Dime dónde estás', 'Saber nunca fue el problema', 'El miedo también decide',
  'Una creencia no es un hecho', 'Ingreso ≠ libertad', 'Libertad = poder elegir', 'Decides tú',
];

const rueda = [
  { t: 'Cuerpo' },
  { t: 'Emociones' },
  { t: 'Dinero' },
];

const pasos = [
  'Una rueda pinchada [r]no llega lejos.[/r]',
  'Tu cuerpo te cobra [r]lo que no le das.[/r]',
  'El miedo [r]también decide.[/r]',
  '¿Eso es un sueldo [r]o un precio?[/r]',
  'Cierra los ojos. [r]Es 2029.[/r]',
];

const areas = ['Salud física', 'Salud emocional', 'Nuevos ingresos', 'Más tiempo libre'];

const info = [
  ['Fecha', evento.fecha],
  ['Hora', evento.hora],
  ['Lugar', evento.lugar],
  ['Duración', evento.duracion],
];
---
<Base title="Sintonízate Vigo — ¿Cuánto te está costando no cambiar?" description="Día 1 · Despertar. Dos horas gratis en Vigo para mirar tu cuerpo, tus emociones y tu dinero. Con Raquel Rodríguez e Iris Soares.">
  <!-- ── Portada (rojo a sangre, como la diapositiva 02 de la v7) ── -->
  <section id="top" class="hero sec-red">
    <header class="nav">
      <a href="#top" class="in nav-logo" style="--d:.05s"><Logo size="24px" tone="onred" icon /></a>
      <nav class="in nav-pill" style="--d:.15s" aria-label="Secciones">
        <a href="#experiencia">Experiencia</a>
        <a href="#ponentes">Ponentes</a>
        <a href="#info">Información</a>
      </nav>
      <a href="#inscripcion" class="in nav-cta" style="--d:.25s"><span class="dot dot-w" aria-hidden="true"></span>Reserva tu plaza</a>
    </header>

    <div class="hero-main">
      <span class="in pill pill-red" style="--d:.3s"><span class="dot dot-w" aria-hidden="true"></span>Día 1 · Despertar · Vigo · Gratis · 2 horas</span>
      <h1 class="display">
        <span class="line"><span class="in-up" style="--d:.4s">¿Cuánto te está</span></span>
        <span class="line"><span class="in-up" style="--d:.52s">costando</span></span>
        <span class="line"><span class="in-up hl" style="--d:.64s">no cambiar?</span></span>
      </h1>
      <div class="hero-row">
        <div class="in hero-ctas" style="--d:1s">
          <a href="#inscripcion" class="btn btn-ink">Reserva tu plaza gratis <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#experiencia" class="btn btn-line">Qué vas a vivir</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Cinta de frases ── -->
  <div class="ticker" aria-label="Frases del evento">
    <div class="ticker-track">
      {[0, 1].map((copy) => ticker.map((t) => (
        <span class="tk" aria-hidden={copy === 1 ? 'true' : undefined}>{t}<span class="tk-dot" aria-hidden="true"></span></span>
      )))}
    </div>
  </div>

  <!-- ── 60 meses ── -->
  <section class="sec sec-light meses">
    <div class="wrap split">
      <div class="col">
        <span class="pill rv"><span class="dot" aria-hidden="true"></span>5 años · 60 meses</span>
        <h2 class="display h-lg rv" set:html={hl('¿Cuántas veces<br>más vas a hacer<br>[r]lo mismo?[/r]')} />
      </div>
      <div class="dots-wrap rv" aria-hidden="true">
        <div class="dots-legend"><span>Hoy</span><span class="red">Mes 60</span></div>
        <div class="dots" id="dots">
          {Array.from({ length: 60 }, (_, i) => <span class:list={['d', { last: i === 59 }]} style={`--i:${i}`}></span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ── La rueda (negro, como los pasos de la v7) ── -->
  <section class="sec sec-dark rueda">
    <div class="wrap">
      <div class="col narrow">
        <span class="pill pill-dark rv"><span class="dot" aria-hidden="true"></span>Prosperidad 360°</span>
        <h2 class="display h-xl rv" set:html={hl('Tres dimensiones.<br>[r]Una palabra.[/r]')} />
      </div>
      <div class="rueda-grid">
        {rueda.map((r, i) => (
          <article class="rcard rv" style={`--d:${i * .08}s`}><span class="rn">0{i + 1}</span><span class="rt">{r.t}</span></article>
        ))}
        <article class="rcard rcard-red rv" style="--d:.24s"><span class="rn">= las une</span><span class="rt">Libertad</span></article>
      </div>
    </div>
  </section>

  <!-- ── La experiencia · 5 pasos ── -->
  <section id="experiencia" class="sec sec-light exp">
    <div class="wrap exp-grid">
      <div class="col sticky">
        <span class="pill rv"><span class="dot" aria-hidden="true"></span>La experiencia · 120 minutos</span>
        <h2 class="display h-lg rv" set:html={hl('No vienes a escuchar.<br>Vienes a [r]cuestionarte.[/r]')} />
      </div>
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li class="rv"><span class="pn">Paso {i + 1}</span><span class="pt" set:html={hl(p)} /></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Decides tú (rojo) ── -->
  <section class="sec sec-red decides">
    <div class="wrap">
      <span class="pill pill-red rv"><span class="dot dot-w" aria-hidden="true"></span>Tres caminos</span>
      <h2 class="display h-xxl rv" set:html={hl('Tres caminos.<br>[r]Decides tú.[/r]')} />
    </div>
  </section>

  <!-- ── Ponentes ── -->
  <section id="ponentes" class="sec sec-light speakers">
    <div class="wrap">
      <div class="speakers-head">
        <div class="col">
          <span class="pill rv"><span class="dot" aria-hidden="true"></span>Ponentes</span>
          <h2 class="display h-lg rv" set:html={hl('Dos voces.<br>Una [r]misma pregunta.[/r]')} />
        </div>
      </div>
      <div class="speakers-grid">
        {ponentes.map((p) => (
          <article class="speaker rv">
            <div class="photo">
              {p.foto
                ? <img src={`${base}img/${p.foto}`} alt={p.nombre} loading="lazy" width="900" height="900" />
                : <span class="photo-ph">Foto de {p.nombre}</span>}
            </div>
            <div class="speaker-meta"><span class="s-area">{p.area}</span><span class="s-name">{p.nombre}</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Información ── -->
  <section id="info" class="info">
    <div class="wrap info-grid">
      {info.map(([k, v]) => (
        <div class="info-card rv"><span class="k">{k}</span><span class="v">{v}</span></div>
      ))}
    </div>
  </section>

  <!-- ── Inscripción (negro) ── -->
  <section id="inscripcion" class="signup">
    <div class="wrap signup-box sec-dark">
      <div class="col">
        <span class="pill pill-dark"><span class="dot" aria-hidden="true"></span>Inscripción gratuita · 120 min · Vigo</span>
        <h2 class="display h-lg" set:html={hl('La motivación dura 24 horas.<br>Una decisión, [r]años.[/r]')} />
      </div>
      <div>
        <div class="done" id="done" hidden tabindex="-1">
          <span class="done-tag"><span class="dot" aria-hidden="true"></span>Plaza reservada</span>
          <span class="display done-title">Gracias, <span class="hl" id="done-name"></span></span>
          <span class="done-text">Te escribiremos al <span id="done-phone"></span> por WhatsApp con la fecha, la hora y el lugar.</span>
          <button type="button" class="btn-again" id="again">Inscribir a otra persona</button>
        </div>

        <form id="form" class="form" novalidate data-endpoint={SHEETS_ENDPOINT}>
          <label class="field"><span>Nombre y apellidos</span><input name="nombre" autocomplete="name" placeholder="Tu nombre" required /></label>
          <div class="field-row">
            <label class="field"><span>Teléfono (WhatsApp)</span><input name="telefono" autocomplete="tel" placeholder="+34 600 000 000" inputmode="tel" type="tel" required /></label>
            <label class="field"><span>Correo electrónico</span><input name="email" autocomplete="email" placeholder="tu@correo.com" type="email" required /></label>
          </div>
          <fieldset class="areas">
            <legend>¿Qué área te gustaría transformar primero?</legend>
            <div class="areas-grid">
              {areas.map((a) => (
                <button type="button" class="area" aria-pressed="false" data-area={a}><span class="area-dot" aria-hidden="true"></span>{a}</button>
              ))}
            </div>
          </fieldset>
          <!-- Campo trampa contra bots: las personas no lo ven -->
          <label class="visually-hidden" aria-hidden="true">Web<input name="web" tabindex="-1" autocomplete="off" /></label>
          <span class="error" id="error" role="alert"></span>
          <button type="submit" class="btn-submit" id="submit">Reservar mi plaza gratis <span class="arrow lg" aria-hidden="true">→</span></button>
          <span class="legal">Te confirmamos fecha, hora y lugar por WhatsApp. Solo usaremos tus datos para el evento.</span>
        </form>
      </div>
    </div>
  </section>

  <!-- ── Cierre ── -->
  <footer class="site-foot">
    <h2 class="display h-xl rv" set:html={hl('Lo inevitable<br>también era<br>[r]una decisión.[/r]')} />
    <div class="foot-row">
      <Logo size="clamp(40px,7vw,96px)" icon />
    </div>
    <div class="foot-meta"><span>{evento.pie}</span><a href="#top">Volver arriba ↑</a></div>
  </footer>
</Base>

<script>
  // ── Aparición al hacer scroll (sin JS o con movimiento reducido, todo se ve) ──
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('rv-on');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    document.querySelectorAll('.rv, #dots').forEach((el) => io.observe(el));
  } else {
    document.getElementById('dots')?.classList.add('is-in');
  }

  // ── Formulario ──
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done') as HTMLElement;
  const errorEl = document.getElementById('error') as HTMLElement;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const endpoint = form.dataset.endpoint || '';
  let area = '';

  form.querySelectorAll<HTMLButtonElement>('.area').forEach((b) => {
    b.addEventListener('click', () => {
      area = b.dataset.area || '';
      form.querySelectorAll('.area').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    });
  });
  form.addEventListener('input', () => { errorEl.textContent = ''; });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const nombre = String(fd.get('nombre') || '').trim();
    const telefono = String(fd.get('telefono') || '').trim();
    const email = String(fd.get('email') || '').trim();
    if (!nombre) return fail('Escribe tu nombre.', 'nombre');
    if (telefono.replace(/\D/g, '').length < 9) return fail('Revisa el teléfono: necesitamos tu WhatsApp.', 'telefono');
    if (!/^\S+@\S+\.\S+$/.test(email)) return fail('Revisa el correo electrónico.', 'email');
    if (fd.get('web')) return; // bot
    if (!endpoint) return fail('Las inscripciones aún no están activas. Inténtalo de nuevo en unos días.');

    submit.disabled = true;
    submit.setAttribute('aria-busy', 'true');
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        // Petición "simple" (sin preflight CORS), compatible con Apps Script.
        body: new URLSearchParams({ nombre, telefono, email, area, origen: location.href }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.ok !== true) throw new Error(data.error || 'Error ' + res.status);
      (document.getElementById('done-name') as HTMLElement).textContent = nombre.split(/\s+/)[0] + '.';
      (document.getElementById('done-phone') as HTMLElement).textContent = telefono;
      form.hidden = true;
      done.hidden = false;
      done.focus();
    } catch (err) {
      console.error(err);
      fail('No hemos podido guardar tu inscripción. Revisa tu conexión e inténtalo de nuevo.');
    } finally {
      submit.disabled = false;
      submit.removeAttribute('aria-busy');
    }
  });

  document.getElementById('again')!.addEventListener('click', () => {
    form.reset();
    area = '';
    form.querySelectorAll('.area').forEach((o) => o.setAttribute('aria-pressed', 'false'));
    done.hidden = true;
    form.hidden = false;
    (form.elements.namedItem('nombre') as HTMLInputElement).focus();
  });

  function fail(msg: string, field?: string) {
    errorEl.textContent = msg;
    if (field) (form.elements.namedItem(field) as HTMLInputElement).focus();
  }
</script>

<style>
  /* ── Sistema v7 ─────────────────────────── */
  .wrap { max-width: 1320px; margin: 0 auto; }
  .red { color: var(--red); }
  .col { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(18px, 2.2vw, 30px); }
  .display { margin: 0; font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: .004em; line-height: 1.03; text-wrap: balance; }
  .display :global(.hl) { color: var(--red); }
  .sec-red .display :global(.hl) { color: #0B0B0C; }
  .h-lg { font-size: clamp(42px, 6vw, 96px); }
  .h-xl { font-size: clamp(48px, 7.4vw, 124px); }
  .h-xxl { font-size: clamp(60px, 11vw, 190px); }

  .sec { padding: clamp(80px, 11vw, 160px) var(--gutter); position: relative; }
  .sec-light { background: radial-gradient(50% 50% at 92% 0%, rgba(255,59,48,.10), rgba(255,59,48,0) 70%), radial-gradient(50% 60% at 0% 100%, rgba(170,175,200,.22), rgba(255,255,255,0) 70%), #FFFFFF; color: var(--ink); }
  .sec-red { background: radial-gradient(60% 70% at 100% 0%, rgba(255,255,255,.18), rgba(255,255,255,0) 70%), #FF3B30; color: #FFFFFF; }
  .sec-dark { background: radial-gradient(50% 60% at 100% 100%, rgba(255,59,48,.22), rgba(0,0,0,0) 70%), #0B0B0C; color: #F5F5F7; }

  .pill { display: inline-flex; align-items: center; gap: 12px; min-height: 40px; padding: 8px 18px 8px 15px; border-radius: 999px; font-family: 'Anton', sans-serif; text-transform: uppercase; letter-spacing: .06em; font-size: 15px; font-weight: 400; line-height: 1; color: #6E6E73; background: rgba(128,128,128,.08); border: 1px solid rgba(128,128,128,.2); }
  .pill-dark { color: #A1A1A6; }
  .pill-red { color: #FFFFFF; background: rgba(0,0,0,.08); border-color: rgba(255,255,255,.35); }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--red); box-shadow: 0 0 12px rgba(255,59,48,.9); }
  .dot-w { background: #FFFFFF; box-shadow: none; }

  /* ── Animaciones ────────────────────────── */
  @keyframes soft { from { opacity: 0; transform: translateY(14px); } }
  @keyframes rise { from { opacity: 0; transform: translateY(70%); } }
  .in { animation: soft 1s var(--ease-out) var(--d, .05s) backwards; }
  /* El padding superior deja sitio a las tildes de las mayúsculas (Á, É…) dentro de la máscara. */
  .line { display: block; overflow: hidden; padding: .14em 0 .04em; margin-top: -.14em; }
  .in-up { display: block; animation: rise 1.1s var(--ease-out) var(--d, .05s) backwards; }
  :global(.rv-on) .rv { opacity: 0; transform: translateY(28px); transition: opacity .9s var(--ease-out) var(--d, 0s), transform .9s var(--ease-out) var(--d, 0s); }
  :global(.rv-on) .rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .in, .in-up { animation: none; } }

  /* ── Portada ────────────────────────────── */
  .hero { min-height: min(100vh, 1000px); min-height: min(100svh, 1000px); display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
  .nav { position: relative; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; padding: 20px var(--gutter); }
  .nav-logo { justify-self: start; }
  .nav-pill { display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 999px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.3); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .nav-pill a { height: 34px; padding: 0 16px; border-radius: 999px; display: flex; align-items: center; font-size: 14px; font-weight: 500; color: #FFFFFF; transition: background .25s; }
  .nav-pill a:hover { background: rgba(0,0,0,.14); }
  .nav-cta { justify-self: end; grid-column: 3; height: 40px; padding: 0 18px; border-radius: 999px; display: flex; align-items: center; gap: 10px; background: #0B0B0C; color: #FFFFFF; font-size: 14px; font-weight: 500; white-space: nowrap; transition: transform .25s var(--ease-out); }
  .nav-cta:hover { transform: translateY(-1px); }
  @media (max-width: 900px) { .nav-pill { display: none; } }
  @media (max-width: 420px) { .nav-cta { display: none; } }
  @media (max-width: 640px) { .hero { min-height: 0; } .hero-main { padding-top: 56px; } }

  .hero-main { display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: clamp(22px, 3vw, 36px); padding: clamp(24px, 4vh, 48px) var(--gutter) clamp(40px, 7vh, 88px); max-width: 1448px; width: 100%; margin: 0 auto; }
  h1.display { font-size: clamp(58px, 11.4vw, 196px); line-height: .98; }
  .hero-row { width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 40px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .btn { flex: none; white-space: nowrap; height: 56px; border-radius: 999px; display: inline-flex; align-items: center; font-size: 16px; font-weight: 500; transition: transform .3s var(--ease-out), background .25s, border-color .25s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-ink { padding: 0 8px 0 26px; gap: 14px; background: #0B0B0C; color: #FFFFFF; }
  .btn-line { padding: 0 24px; border: 1.5px solid rgba(255,255,255,.75); color: #FFFFFF; }
  .btn-line:hover { border-color: #FFFFFF; background: rgba(255,255,255,.1); }
  .arrow { width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 17px; transition: transform .35s var(--ease-out); }
  .btn-ink .arrow { background: #FFFFFF; color: #0B0B0C; }
  .btn:hover .arrow, .btn-submit:hover .arrow { transform: translateX(3px); }

  /* ── Cinta ──────────────────────────────── */
  .ticker { background: #0B0B0C; color: #F5F5F7; overflow: hidden; padding: 22px 0; }
  @keyframes tick { to { transform: translateX(-50%); } }
  .ticker-track { display: flex; width: max-content; animation: tick 46s linear infinite; }
  .ticker:hover .ticker-track { animation-play-state: paused; }
  .tk { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: 'Anton', sans-serif; text-transform: uppercase; letter-spacing: .02em; font-size: clamp(24px, 3vw, 40px); line-height: 1; white-space: nowrap; }
  .tk-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--red); box-shadow: 0 0 14px rgba(255,59,48,.9); }
  @media (prefers-reduced-motion: reduce) { .ticker { overflow-x: auto; } .ticker-track { animation: none; } }

  /* ── 60 meses ───────────────────────────── */
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: clamp(48px, 7vw, 110px); align-items: center; }
  .dots-wrap { display: flex; flex-direction: column; gap: 22px; }
  .dots-legend { display: flex; justify-content: space-between; font-family: 'Anton', sans-serif; text-transform: uppercase; letter-spacing: .06em; font-size: 15px; color: #6E6E73; }
  .dots { display: grid; grid-template-columns: repeat(10, 1fr); gap: clamp(12px, 1.8vw, 26px); }
  .d { aspect-ratio: 1; border-radius: 50%; background: #3A3A3C; }
  .d.last { background: var(--red); box-shadow: 0 0 0 0 rgba(255,59,48,.6); }
  :global(.rv-on) #dots .d { opacity: 0; transform: scale(.3); transition: opacity .5s ease, transform .6s cubic-bezier(.34,1.56,.64,1); transition-delay: calc(var(--i) * 22ms + .2s); }
  :global(.rv-on) #dots.is-in .d { opacity: 1; transform: none; }
  @keyframes beat { 0% { box-shadow: 0 0 0 0 rgba(255,59,48,.55); } 70%, 100% { box-shadow: 0 0 0 18px rgba(255,59,48,0); } }
  #dots.is-in .d.last { animation: beat 2.2s 1.8s infinite; }

  /* ── Rueda ──────────────────────────────── */
  .narrow { max-width: 1000px; margin-bottom: clamp(40px, 6vw, 80px); }
  .rueda-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  .rcard { min-height: clamp(170px, 20vw, 260px); border-radius: 28px; padding: 30px; display: flex; flex-direction: column; gap: 10px; background: linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.02)); border: 1px solid rgba(255,255,255,.1); }
  .rn { font-family: 'Anton', sans-serif; letter-spacing: .06em; text-transform: uppercase; font-size: 15px; color: #86868B; margin-bottom: auto; }
  .rt { font-family: 'Anton', sans-serif; text-transform: uppercase; font-size: clamp(36px, 3.4vw, 52px); line-height: 1; letter-spacing: .01em; }
  .rcard-red { background: #FF3B30; border-color: #FF3B30; box-shadow: 0 30px 80px rgba(255,59,48,.25); }
  .rcard-red .rn { color: #0B0B0C; }

