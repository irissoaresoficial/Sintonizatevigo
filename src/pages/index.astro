---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { evento, ponentes, SHEETS_ENDPOINT } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const cards = [
  { n: '01', t: 'Cuerpo', d: 'Sin energía física, todo cuesta más.' },
  { n: '02', t: 'Emociones', d: 'Tus decisiones, hábitos y relaciones influyen en cómo actúas.' },
  { n: '03', t: 'Dinero', d: 'Su falta limita tus opciones, tu tiempo y tus decisiones.' },
  { n: '= las une', t: 'Libertad', d: '¿Para qué quieres prosperar realmente?', dark: true },
  { n: '04', t: 'Tiempo', d: '¿Cuánto de tu vida entregas para mantener tus ingresos?' },
  { n: '05', t: 'Decisión', d: 'No quiero convencerte de nada. Decides tú.' },
];

const agenda = [
  ['0:00', 'Romper el patrón', 'Puntúa tu vida del 1 al 10, con honestidad.'],
  ['0:10', 'La rueda de la prosperidad', 'Cuerpo, emociones y dinero, unidos por la libertad.'],
  ['0:25', 'Tu primer capital', 'Energía, descanso y hábitos: de saber lo que deberías hacer a hacerlo.'],
  ['0:50', 'El precio de vivir en automático', 'Miedos, creencias sobre el dinero y patrones que se repiten.'],
  ['1:15', 'Ingreso ≠ libertad', '¿Cuánto de tu vida entregas para mantener tus ingresos?'],
  ['1:40', 'El momento de quiebre', 'Tú, dentro de tres años. ¿Qué tuvo que cambiar?'],
  ['1:50', 'Tres caminos', 'No cambiar, cambiar tus hábitos o explorar nuevas oportunidades. Decides tú.'],
];

const areas = ['Salud física', 'Salud emocional', 'Nuevos ingresos', 'Más tiempo libre'];

const info = [
  ['Fecha', evento.fecha],
  ['Hora', evento.hora],
  ['Lugar', evento.lugar],
  ['Duración', evento.duracion],
];
---
<Base title="Sintonízate Vigo — ¿Cuánto te está costando no cambiar?">
  <section id="top" class="hero">
    <div class="hero-bg" aria-hidden="true"></div>

    <header class="nav">
      <a href="#top" class="in-soft nav-logo" style="--d:.05s"><Logo size="22px" supSize="7px" /></a>
      <nav class="in-soft nav-pill" style="--d:.15s" aria-label="Secciones">
        <a href="#experiencia">Experiencia</a>
        <a href="#ponentes">Ponentes</a>
        <a href="#info">Información</a>
      </nav>
      <a href="#inscripcion" class="in-soft nav-cta" style="--d:.25s"><span class="dot dot-7" aria-hidden="true"></span>Reserva tu plaza</a>
    </header>

    <main class="hero-main">
      <div class="hero-inner">
        <span class="in-soft eyebrow-hero" style="--d:.3s"><span class="dot" aria-hidden="true"></span>Evento · Vigo · Raquel Rodríguez e Iris Soares</span>
        <h1>
          <span class="mask"><span class="in-mask" style="--d:.4s">¿Cuánto te está costando</span></span>
          <span class="mask"><span class="in-mask strong" style="--d:.55s">no cambiar<span class="red">?</span></span></span>
        </h1>
        <div class="hero-row">
          <p class="in-soft hero-lead" style="--d:.75s"><span class="ink">Tu salud, tus emociones y tu dinero están más conectados de lo que imaginas.</span> Un evento para mirarlos de frente y decidir.</p>
          <div class="in-soft hero-ctas" style="--d:.9s">
            <a href="#inscripcion" class="btn-primary">Reserva tu plaza gratis <span class="arrow" aria-hidden="true">→</span></a>
            <a href="#experiencia" class="btn-glass">Qué vas a vivir</a>
          </div>
        </div>
      </div>
    </main>

    <footer class="hero-foot">
      <span class="in-soft" style="--d:1s"><span class="n">01</span>Salud física</span>
      <span class="in-soft" style="--d:1.08s"><span class="n">02</span>Salud emocional</span>
      <span class="in-soft" style="--d:1.16s"><span class="n">03</span>Salud financiera</span>
      <span class="in-soft ink" style="--d:1.24s"><span class="n red">=</span>Libertad</span>
    </footer>
  </section>

  <section class="concept">
    <div class="wrap concept-inner">
      <div class="head">
        <span class="eyebrow"><span class="dot" aria-hidden="true"></span>El concepto</span>
        <h2 class="h-concept">Tu salud, tus emociones y tu dinero <span class="grey">están más conectados de lo que imaginas.</span></h2>
      </div>
      <div class="marquee">
        <div class="track">
          {[0, 1].map((copy) => cards.map((c) => (
            <article class:list={['mcard', { dark: c.dark }]} aria-hidden={copy === 1 ? 'true' : undefined}>
              <span class="mcard-n">{c.n}</span>
              <div class="mcard-body"><span class="mcard-t">{c.t}</span><span class="mcard-d">{c.d}</span></div>
            </article>
          )))}
        </div>
      </div>
    </div>
  </section>

  <section id="experiencia" class="exp">
    <div class="wrap exp-grid">
      <div class="head sticky">
        <span class="eyebrow"><span class="dot" aria-hidden="true"></span>La experiencia · 120 min</span>
        <h2 class="h2">No vienes a escuchar. <span class="grey">Vienes a cuestionarte.</span></h2>
        <p class="lead">Preguntas, ejercicios por escrito, silencio y acción. El ritmo cambia cada 10–15 minutos.</p>
      </div>
      <ol class="agenda">
        {agenda.map(([t, title, desc], i) => (
          <li><span class:list={['t', { red: i === 0 }]}>{t}</span><div><span class="a-title">{title}</span><span class="a-desc">{desc}</span></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section id="ponentes" class="speakers">
    <div class="wrap speakers-inner">
      <div class="speakers-head">
        <div class="head">
          <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Ponentes</span>
          <h2 class="h2">Dos voces. <span class="grey">Una misma pregunta.</span></h2>
        </div>
        <span class="side-note">Dos miradas complementarias sobre tu salud, tus emociones y tu dinero.</span>
      </div>
      <div class="speakers-grid">
        {ponentes.map((p) => (
          <article class="speaker">
            <div class="photo">
              {p.foto
                ? <img src={`${base}img/${p.foto}`} alt={p.nombre} loading="lazy" width="900" height="900" />
                : <span class="photo-ph">Foto de {p.nombre}</span>}
            </div>
            <div class="speaker-meta"><span class="s-area">{p.area}</span><span class="s-name">{p.nombre}</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="info" class="info">
    <div class="wrap info-grid">
      {info.map(([k, v]) => (
        <div class="info-card"><span class="k">{k}</span><span class="v">{v}</span></div>
      ))}
    </div>
  </section>

  <section id="inscripcion" class="signup">
    <div class="wrap signup-box">
      <div class="head">
        <span class="eyebrow on-dark"><span class="dot" aria-hidden="true"></span>Inscripción gratuita · Plazas limitadas</span>
        <h2 class="h-signup">Reserva tu sitio. <span class="grey">Lo demás lo decides allí.</span></h2>
        <p class="lead on-dark">Te confirmaremos la fecha, la hora y el lugar por WhatsApp.</p>
      </div>
      <div>
        <div class="done" id="done" hidden tabindex="-1">
          <span class="done-tag"><span class="dot" aria-hidden="true"></span>Plaza reservada</span>
          <span class="done-title">Gracias, <span class="strong" id="done-name"></span></span>
          <span class="done-text">Te escribiremos al <span id="done-phone"></span> con todos los detalles.</span>
          <button type="button" class="btn-again" id="again">Inscribir a otra persona</button>
        </div>

        <form id="form" class="form" novalidate data-endpoint={SHEETS_ENDPOINT}>
          <label class="field"><span>Nombre y apellidos</span><input name="nombre" autocomplete="name" placeholder="Tu nombre" required /></label>
          <div class="field-row">
            <label class="field"><span>Teléfono (WhatsApp)</span><input name="telefono" autocomplete="tel" placeholder="+34 600 000 000" inputmode="tel" type="tel" required /></label>
            <label class="field"><span>Correo electrónico</span><input name="email" autocomplete="email" placeholder="tu@correo.com" type="email" required /></label>
          </div>
          <fieldset class="areas">
            <legend>¿Qué área te gustaría transformar primero?</legend>
            <div class="areas-grid">
              {areas.map((a) => (
                <button type="button" class="area" aria-pressed="false" data-area={a}><span class="area-dot" aria-hidden="true"></span>{a}</button>
              ))}
            </div>
          </fieldset>
          <!-- Campo trampa contra bots: las personas no lo ven -->
          <label class="visually-hidden" aria-hidden="true">Web<input name="web" tabindex="-1" autocomplete="off" /></label>
          <span class="error" id="error" role="alert"></span>
          <button type="submit" class="btn-submit" id="submit">Reservar mi plaza <span class="arrow lg" aria-hidden="true">→</span></button>
          <span class="legal">Solo usaremos tus datos para enviarte la información del evento.</span>
        </form>
      </div>
    </div>
  </section>

  <footer class="site-foot">
    <p class="quote">La prosperidad no empieza cuando ganas más dinero. <span class="grey">Empieza cuando dejas de aceptar como inevitable una vida que ya sabes que quieres cambiar.</span></p>
    <div class="foot-row">
      <Logo size="clamp(52px,10vw,150px)" supSize="13px" supGap="6px" lineHeight={0.85} tracking="-0.055em" />
      <span class="foot-meta">{evento.pie}</span>
    </div>
  </footer>
</Base>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done') as HTMLElement;
  const errorEl = document.getElementById('error') as HTMLElement;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const endpoint = form.dataset.endpoint || '';
  let area = '';

  form.querySelectorAll<HTMLButtonElement>('.area').forEach((b) => {
    b.addEventListener('click', () => {
      area = b.dataset.area || '';
      form.querySelectorAll('.area').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    });
  });
  form.addEventListener('input', () => { errorEl.textContent = ''; });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const nombre = String(fd.get('nombre') || '').trim();
    const telefono = String(fd.get('telefono') || '').trim();
    const email = String(fd.get('email') || '').trim();
    if (!nombre) return fail('Escribe tu nombre.', 'nombre');
    if (telefono.replace(/\D/g, '').length < 9) return fail('Revisa el teléfono: necesitamos tu WhatsApp.', 'telefono');
    if (!/^\S+@\S+\.\S+$/.test(email)) return fail('Revisa el correo electrónico.', 'email');
    if (fd.get('web')) return; // bot
    if (!endpoint) return fail('Las inscripciones aún no están activas. Inténtalo de nuevo en unos días.');

    submit.disabled = true;
    submit.setAttribute('aria-busy', 'true');
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        // Petición "simple" (sin preflight CORS), compatible con Apps Script.
        body: new URLSearchParams({ nombre, telefono, email, area, origen: location.href }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.ok !== true) throw new Error(data.error || 'Error ' + res.status);
      (document.getElementById('done-name') as HTMLElement).textContent = nombre.split(/\s+/)[0] + '.';
      (document.getElementById('done-phone') as HTMLElement).textContent = telefono;
      form.hidden = true;
      done.hidden = false;
      done.focus();
    } catch (err) {
      console.error(err);
      fail('No hemos podido guardar tu inscripción. Revisa tu conexión e inténtalo de nuevo.');
    } finally {
      submit.disabled = false;
      submit.removeAttribute('aria-busy');
    }
  });

  document.getElementById('again')!.addEventListener('click', () => {
    form.reset();
    area = '';
    form.querySelectorAll('.area').forEach((o) => o.setAttribute('aria-pressed', 'false'));
    done.hidden = true;
    form.hidden = false;
    (form.elements.namedItem('nombre') as HTMLInputElement).focus();
  });

  function fail(msg: string, field?: string) {
    errorEl.textContent = msg;
    if (field) (form.elements.namedItem(field) as HTMLInputElement).focus();
  }
</script>

<style>
  /* ── Utilidades ─────────────────────────── */
  .wrap { max-width: 1320px; margin: 0 auto; }
  .red { color: var(--red); }
  .ink { color: var(--ink); }
  .grey { color: var(--muted-2); }
  .strong { font-weight: 400; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--red); }
  .dot-7 { width: 7px; height: 7px; }
  .head { display: flex; flex-direction: column; gap: 22px; }
  .eyebrow { display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 500; color: var(--muted-2); }
  .eyebrow.on-dark, .lead.on-dark { color: var(--muted-3); }
  .h2 { margin: 0; font-weight: 300; font-size: clamp(34px, 4.4vw, 68px); line-height: 1.04; letter-spacing: -0.045em; text-wrap: balance; }
  .lead { margin: 0; font-size: 18px; font-weight: 300; line-height: 1.55; color: var(--muted); max-width: 440px; }

  /* ── Animaciones de entrada ─────────────── */
  @keyframes soft { from { opacity: 0; transform: translateY(14px); } }
  @keyframes rise { from { opacity: 0; transform: translateY(40%); } }
  .in-soft, .in-mask { animation: soft 1.1s var(--ease-out) var(--d, .05s) backwards; }
  .in-mask { display: block; animation-name: rise; }
  .mask { display: block; overflow: hidden; padding-bottom: .06em; }
  @media (prefers-reduced-motion: reduce) { .in-soft, .in-mask { animation: none; } }

  /* ── Portada ────────────────────────────── */
  .hero { position: relative; height: 100vh; height: 100svh; min-height: 660px; display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; background:
    radial-gradient(45% 55% at 85% 10%, rgba(255,59,48,.14), rgba(255,59,48,0) 70%),
    radial-gradient(50% 60% at 5% 90%, rgba(170,178,200,.35), rgba(255,255,255,0) 70%),
    linear-gradient(180deg, #FFFFFF, #F5F5F7); }

  .nav { position: relative; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; padding: 20px var(--gutter); }
  .nav-logo { justify-self: start; color: var(--ink); }
  .nav-pill { display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 999px; background: rgba(227,227,225,.55); border: 1px solid rgba(0,0,0,.12); backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%); }
  .nav-pill a { height: 34px; padding: 0 16px; border-radius: 999px; display: flex; align-items: center; font-size: 13.5px; font-weight: 400; color: var(--ink-2); transition: background .25s; }
  .nav-pill a:hover { background: rgba(0,0,0,.1); }
  .nav-cta { justify-self: end; grid-column: 3; height: 38px; padding: 0 18px; border-radius: 999px; display: flex; align-items: center; gap: 10px; background: var(--ink); color: #FFFFFF; font-size: 13.5px; font-weight: 500; white-space: nowrap; transition: background .25s; }
  .nav-cta:hover { background: var(--ink-deep); }
  @media (max-width: 900px) { .nav-pill { display: none; } }

  .hero-main { position: relative; z-index: 1; display: flex; align-items: flex-end; padding: 0 var(--gutter) clamp(36px, 6vh, 72px); }
  .hero-inner { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; max-width: 1200px; width: 100%; }
  .eyebrow-hero { display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 400; color: var(--ink-2); }
  h1 { margin: 0; font-weight: 200; font-size: clamp(46px, 7.4vw, 128px); line-height: .98; letter-spacing: -0.055em; color: var(--ink); }
  .hero-row { width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; }
  .hero-lead { margin: 0; max-width: 520px; color: var(--muted); font-size: clamp(17px, 1.3vw, 21px); font-weight: 300; line-height: 1.5; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .btn-primary, .btn-glass { flex: none; white-space: nowrap; height: 54px; border-radius: 999px; display: flex; align-items: center; font-size: 16px; }
  .btn-primary { padding: 0 26px; gap: 12px; background: var(--ink); color: #FFFFFF; font-weight: 500; transition: background .25s; }
  .btn-primary:hover { background: var(--ink-deep); }
  .btn-glass { padding: 0 24px; background: rgba(227,227,225,.55); border: 1px solid rgba(0,0,0,.16); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); color: var(--ink); font-weight: 400; transition: border-color .25s; }
  .btn-glass:hover { border-color: rgba(0,0,0,.45); }
  .arrow { width: 26px; height: 26px; border-radius: 50%; background: var(--red); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; transition: transform .35s var(--ease-out); }
  .arrow.lg { width: 40px; height: 40px; font-size: 18px; }
  .btn-primary:hover .arrow, .btn-submit:hover .arrow { transform: translateX(3px); }

  .hero-foot { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; padding: 22px var(--gutter) 28px; border-top: 1px solid rgba(0,0,0,.1); font-size: 14px; font-weight: 400; color: var(--muted); }
  .hero-foot > span { display: flex; gap: 12px; }
  .hero-foot .n { color: var(--faint); }
  .hero-foot .n.red { color: var(--red); }

  /* ── Concepto + carrusel infinito ───────── */
  .concept { padding: clamp(96px, 12vw, 168px) var(--gutter) clamp(64px, 8vw, 112px); }
  .concept-inner { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 80px); }
  .h-concept { margin: 0; font-weight: 300; font-size: clamp(34px, 4.6vw, 72px); line-height: 1.04; letter-spacing: -0.045em; max-width: 1100px; text-wrap: balance; }
  .marquee { position: relative; margin: 0 calc(-1 * var(--gutter)); overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%); }
  @keyframes marquee { to { transform: translateX(calc(-50% - 8px)); } }
  .track { display: flex; gap: 16px; width: max-content; padding: 4px 0; animation: marquee 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
    .track { animation: none; }
  }
  .mcard { flex: none; width: clamp(280px, 26vw, 380px); height: clamp(300px, 24vw, 340px); border-radius: 28px; padding: 32px; background: var(--card); color: var(--ink); display: flex; flex-direction: column; justify-content: space-between; }
  .mcard-n { font-size: 14px; font-weight: 500; color: var(--muted-2); }
  .mcard-body { display: flex; flex-direction: column; gap: 10px; }
  .mcard-t { font-size: 32px; font-weight: 400; letter-spacing: -0.035em; }
  .mcard-d { font-size: 17px; font-weight: 300; line-height: 1.5; color: var(--muted); min-height: 4.5em; }
  .mcard.dark { background: var(--ink); color: var(--paper); }
  .mcard.dark .mcard-n { color: var(--red); }
  .mcard.dark .mcard-d { color: var(--muted-3); }

  /* ── Experiencia ────────────────────────── */
  .exp { padding: clamp(48px, 6vw, 80px) var(--gutter) clamp(96px, 12vw, 168px); }
  .exp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: clamp(40px, 7vw, 120px); align-items: start; }
  /* Solo fija con dos columnas: en una columna el programa le pasaría por encima. */
  @media (min-width: 1000px) { .sticky { position: sticky; top: 48px; } }
  .agenda { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .agenda li { display: grid; grid-template-columns: 72px 1fr; gap: 20px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .agenda .t { font-size: 15px; font-weight: 500; color: var(--muted-2); padding-top: 6px; font-variant-numeric: tabular-nums; }
  .agenda .t.red { color: var(--red); }
  .agenda li > div { display: flex; flex-direction: column; gap: 6px; }
  .a-title { font-size: 24px; font-weight: 400; letter-spacing: -0.03em; }
  .a-desc { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.5; }

  /* ── Ponentes ───────────────────────────── */
  .speakers { padding: 0 var(--gutter) clamp(96px, 12vw, 168px); }
  .speakers-inner { display: flex; flex-direction: column; gap: clamp(40px, 5vw, 64px); }
  .speakers-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .side-note { font-size: 17px; font-weight: 300; color: var(--muted); max-width: 340px; line-height: 1.5; }
  .speakers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .speaker { border-radius: 28px; overflow: hidden; background: var(--card); display: flex; flex-direction: column; }
  .photo { position: relative; aspect-ratio: 1 / 1; background: var(--line); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 15px; color: var(--muted-2);
    background: repeating-linear-gradient(135deg, rgba(0,0,0,.025) 0 2px, transparent 2px 14px); }
  .speaker-meta { padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px; }
  .s-area { font-size: 13px; font-weight: 500; color: var(--muted-2); }
  .s-name { font-size: 28px; font-weight: 400; letter-spacing: -0.035em; }

  /* ── Información ────────────────────────── */
  .info { padding: 0 var(--gutter) clamp(64px, 8vw, 112px); }
  .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; }
  .info-card { border-radius: 24px; padding: 28px 30px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }
  .info-card .k { font-size: 13px; font-weight: 500; color: var(--muted-2); }
  .info-card .v { font-size: 24px; font-weight: 300; letter-spacing: -0.03em; }

  /* ── Inscripción ────────────────────────── */
  .signup { padding: clamp(24px, 4vw, 48px) var(--gutter) clamp(96px, 12vw, 160px); }
