---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource/dm-sans/300.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Color de fondo del documento (las presentaciones lo cambian). */
  bg?: string;
}
const { title, description = 'Sintonízate Vigo · Tu salud, tus emociones y tu dinero están más conectados de lo que imaginas.', bg = '#FFFFFF' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={bg} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" type="image/svg+xml" href={`${base}marca/logos/sintonizate-vigo-icono-glass-claro.svg`} />
    <link rel="apple-touch-icon" href={`${base}marca/logos/sintonizate-vigo-icono-glass-oscuro.png`} />
    <slot name="head" />
  </head>
  <body style={`background:${bg}`}>
    <slot />
  </body>
</html>
